# menagerie — environment example
# Copy to .env and fill in. NEVER commit real values.

# LLM provider for recon / benches (FreeInference-compatible)
FREEINFERENCE_API_KEY=

# Optional: OpenAI-compatible image generation for `menagerie forge`
# (omitted → forge grabs the first provider block from ~/.omp/agent/models.yml)
IMAGES_API_URL=
IMAGES_API_KEY=
# OPENAI_BASE_URL=   # alt names, same effect
# OPENAI_API_KEY=

# Private deployments only
GATEHOUSE_API_KEY=