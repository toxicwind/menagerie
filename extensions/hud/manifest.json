{
  "manifest_version": 3,
  "name": "menagerie hud",
  "version": "0.4.0",
  "description": "An automation age spirit-haunted by Clippy. The menagerie as a browser side panel: glass HUD, agent cast, vision narrations. Part of the UI, never part of the page.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "menagerie hud"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "hud.html",
        "hud-roam.js",
        "clippy/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}